# Server
PORT=5000

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Gmail SMTP credentials
# IMPORTANT: Do NOT use your normal Gmail password.
# 1. Enable 2-Step Verification on your Google account.
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an "App Password" for "Mail".
# 4. Paste that 16-character app password below (no spaces).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Email address that receives contact-form submissions
# (can be the same as GMAIL_USER)
CONTACT_RECEIVER=youraddress@gmail.com
